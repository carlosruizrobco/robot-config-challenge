{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.example.com/schema/release.schema.json",
  "title": "Release",
  "type": "object",
  "additionalProperties": false,
  "required": ["release", "apps"],
  "properties": {
    "release": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
    },
    "apps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "program", "vision", "agent"],
      "properties": {
        "runtime": { "$ref": "#/$defs/semver" },
        "program": { "$ref": "#/$defs/semver" },
        "vision": { "$ref": "#/$defs/semver" },
        "agent": { "$ref": "#/$defs/semver" }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    }
  }
}
